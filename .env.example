# OpenAI-compatible chat completions API
OPENAI_API_KEY=replace_me
# Optional: set when using an OpenAI-compatible gateway
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
MODEL_TIMEOUT_SECONDS=90

# Tavily is used for web search; obtain a key from https://tavily.com/
TAVILY_API_KEY=replace_me
SEARCH_TIMEOUT_SECONDS=30
FETCH_TIMEOUT_SECONDS=25
MAX_FETCH_BYTES=2097152

# Local storage paths (relative paths are resolved from the project root)
APP_HOME=.
DATA_DIR=./data
WORKSPACE_DIR=./workspaces

# Single-worker runtime
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_LEASE_SECONDS=45
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=120
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_MAX_STEPS=12
DEFAULT_MAX_RUNTIME_SECONDS=3600

# Research PDF extraction uses pypdf; scanned PDFs without text require OCR.
